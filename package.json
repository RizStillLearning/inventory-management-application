{
  "name": "inventory-management",
  "productName": "Stockroom",
  "description": "Inventory management for products, stock levels and stock movements.",
  "author": "Harris Kristanto <harrisk2606@gmail.com>",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "stockroom.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p electron --noEmit",
    "electron:dev": "tsc -p electron && node scripts/electron-dev.js",
    "electron:build": "npm run build && tsc -p electron && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "com.stockroom.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/titlebar.html",
      "build/icon.png",
      "!node_modules/**/*"
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    }
  }
}
