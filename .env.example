# Copy this file to .env and fill in the values from your Supabase project:
# open "Connect" in the top bar, or Project Settings -> API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" public key.
# Never put the service_role / secret key here: everything in .env ships to the browser.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: ISO 4217 currency code used to display prices and stock value.
VITE_CURRENCY=USD
# Optional: locale for numbers and money (defaults to the viewer's browser language),
# and digits after the decimal point (defaults to the currency's standard).
# For Indonesian Rupiah shown as "Rp 15.000":
#   VITE_CURRENCY=IDR
#   VITE_LOCALE=id-ID
#   VITE_CURRENCY_DECIMALS=0
VITE_LOCALE=
VITE_CURRENCY_DECIMALS=
